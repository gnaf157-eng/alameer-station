<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- الكاميرا في الأعلى -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.abognaf.carcounter.OverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="#99000000"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/status_stopped"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="8dp"
            android:background="#99000000"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/hint_line"
            android:textColor="@color/line"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- العدادات أسفل الفيديو -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView style="@style/CounterLabel" android:text="@string/total" />
            <TextView style="@style/CounterLabel" android:text="@string/in_count" android:textColor="@color/in_color" />
            <TextView style="@style/CounterLabel" android:text="@string/out_count" android:textColor="@color/out_color" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/totalText" style="@style/CounterValue" android:text="0" />
            <TextView android:id="@+id/inText" style="@style/CounterValue" android:text="0" android:textColor="@color/in_color" />
            <TextView android:id="@+id/outText" style="@style/CounterValue" android:text="0" android:textColor="@color/out_color" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/toggleButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1.4"
            android:backgroundTint="@color/accent"
            android:text="@string/start"
            android:textColor="@color/bg"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/resetButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/danger"
            android:text="@string/reset"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/swapButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="0.9"
            android:text="@string/swap"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
